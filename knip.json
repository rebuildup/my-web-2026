{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"postcss.config.mjs",
		"scripts/_no-wrangler-hook.mjs",
		"scripts/_no-wrangler-resolver.mjs",
		"scripts/check-knip.mjs",
		"scripts/run-deploy-inner.mjs",
		"scripts/fixtures/**/*.tsx",
		"scripts/*.test.mjs",
		"scripts/fixtures/a11y-image-alt/**/*.tsx",
		"skills/system-quality/scripts/*.mts",
		"test/fixtures/content/stale-review/src/fixture/page.tsx",
		"src/cloudflare/workers-stub.ts"
	],
	"ignoreDependencies": [
		"cloudflare",
		"postcss",
		"@storybook/react",
		"@notionhq/notion-mcp-server"
	],
	"ignoreExportsUsedInFile": true,
	"ignoreIssues": {
		"docs/verification/github-profile/v11/proto-gen6-approved.mjs": ["files"],
		"src/vendor/**": [
			"files",
			"exports",
			"types",
			"duplicates",
			"nsExports",
			"nsTypes",
			"enumMembers",
			"namespaceMembers"
		]
	},
	"ignoreBinaries": ["ffmpeg", "ffprobe", "yt-dlp"]
}
