{
	"name": "my-web-2026",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "my-web-2026 — Personal Web Platform on Cloudflare Workers with TanStack Start, Hono and Panda CSS.",
	"license": "MIT",
	"engines": {
		"node": ">=20.18.0"
	},
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"prepare": "panda codegen",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"wrangler:dry-run": "wrangler deploy --dry-run --outdir dist-cloudflare",
		"cf-typegen": "wrangler types",
		"cf-typegen:check": "pnpm run cf-typegen && git diff --exit-code -- worker-configuration.d.ts",
		"lint:ci": "node scripts/lint-ci.mjs .github/workflows/*.yml",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build -o storybook-static",
		"e2e": "playwright test",
		"e2e:install": "playwright install --with-deps chromium",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint:check": "biome lint .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"validate:fast": "pnpm run format:check && pnpm run lint:check && pnpm run typecheck && pnpm run test",
		"validate:integration": "pnpm run validate:fast && pnpm run build && pnpm run wrangler:dry-run && pnpm run lint:ci && pnpm run build-storybook",
		"validate:release": "pnpm run validate:integration && pnpm run cf-typegen:check"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.168.52",
		"@tanstack/react-start": "^1.168.52",
		"hono": "^4.13.7",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@cloudflare/vite-plugin": "^1.0.0",
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@pandacss/dev": "^1.12.1",
		"@playwright/test": "^1.63.0",
		"@storybook/addon-docs": "^8.6.14",
		"@storybook/addon-essentials": "^8.6.14",
		"@storybook/react-vite": "^8.6.18",
		"@storybook/test": "^8.6.15",
		"@types/node": "^22.20.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.0.0",
		"storybook": "^8.6.18",
		"typescript": "^5.9.0",
		"vite": "^7.1.0",
		"vitest": "~4.1.0",
		"wrangler": "^4.131.0"
	}
}
