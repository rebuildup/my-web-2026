{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"types": ["vite/client", "node"],
		"allowJs": true,
		"checkJs": false,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"paths": {
			"~/*": ["./src/*"],
			"@modules/*": ["./src/modules/*"],
			"@design-system/*": ["./src/design-system/*"],
			"@platform/*": ["./src/platform/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"test/integration/**/*.ts",
		"worker-configuration.d.ts",
		"styled-system/**/*.ts",
		"vite.config.ts",
		"vitest.config.ts",
		"panda.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"dist-cloudflare",
		".output",
		".vinxi",
		".wrangler",
		".tmp",
		".reference"
	]
}
