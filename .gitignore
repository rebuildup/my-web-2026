# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Dependency directories
node_modules/

# Build outputs
dist/
dist-cloudflare/
.output/
.vinxi/
.tanstack/

# Wrangler local state
.wrangler/
# The cf Build Output is disposable; the generated types are the
# canonical, freshness-checked artifact (cf-typegen:check diffs it).
.cloudflare/*
!.cloudflare/types/
!.cloudflare/types/index.d.ts

# Panda CSS generated package (rebuilt via `pnpm prepare`)
styled-system/

# Biome cache
.biome/

# Local env / secrets
.env*
!.env.example
.dev.vars*
!.dev.vars.example

# Infisical one-time bootstrap artefacts (machine identity client
# secret during bootstrap-cf flow). gitignored because the canonical
# binding target is Cloudflare Workers Builds env vars (set via the
# Builds API), not a repo-local file. The client secret must NEVER
# land in a tracked file.
.infisical/

# Type-check cache
*.tsbuildinfo

# Coverage / test artifacts
coverage/
.vitest-cache/

# Playwright E2E
playwright-report/
test-results/
playwright/.cache/
storybook-static/

# Release artifacts
#
# `release-assets/portfolio/<version>/` IS tracked (the publish path
# verifies it). `release-assets/supply-chain/<version>/` is generated
# instead: `pnpm run sbom:check` regenerates the CycloneDX document in
# memory and fails closed when the staged file stops matching
# `pnpm-lock.yaml`, so the artifact never needs to be committed to be
# trustworthy. Rebuild it with `pnpm run sbom:build`.
release-assets/supply-chain/

# Project-local ephemeral state (project-init policy)
.tmp/
.reference/
# External repo worktrees (e.g. rebuildup/ProtoType pilot integration
# in `external/prototype/` for Issue #81). These are full clones
# checked out at a pinned commit but NOT registered as submodules
# (no `.gitmodules`); biome / lint / format must not touch them.
external/

# Local coding-agent harness state (pi / Claude Code). These directories
# hold per-machine agent settings and extensions; they are never
# repository content. They are listed here because `biome.json` reads
# this file (`vcs.useIgnoreFile`), so an ignored directory is also out
# of the format / lint scope — a local agent run must not turn the
# repository's own gates red.
.pi/
.claude/

# Editor / OS
.DS_Store
.vscode/*
!.vscode/settings.json
.idea/
