{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"types": ["vite/client", "node"],
		"allowJs": true,
		"checkJs": false,
		// Explicit `.ts` import specifiers (Issues #433 and #463). The package
		// is `"type": "module"`, so Node's ESM resolver — and therefore any
		// `.mjs` script that runs a `src/` module directly under Node's type
		// stripping — requires the real extension. Without this flag
		// TypeScript rejects those specifiers, which would force the i18n
		// policy / capture scripts (Issue #433) and the webhook verification
		// report script (Issue #463) to duplicate the shipped adapter instead
		// of executing the same code the contract tests assert on. Every other
		// `src/` import in the repository stays extensionless.
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"test/integration/**/*.ts",
		"worker-configuration.d.ts",
		".cloudflare/types/index.d.ts",
		"styled-system/**/*.ts",
		"vite.config.ts",
		"vitest.config.ts",
		"panda.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"dist-cloudflare",
		".output",
		".vinxi",
		".wrangler",
		".tmp",
		".reference"
	]
}
