# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Dependency directories
node_modules/

# Build outputs
dist/
dist-cloudflare/
.output/
.vinxi/
.tanstack/

# Wrangler local state
.wrangler/

# Panda CSS generated package (rebuilt via `pnpm prepare`)
styled-system/

# Biome cache
.biome/

# Local env / secrets
.env*
!.env.example
.dev.vars*
!.dev.vars.example

# Infisical one-time bootstrap artefacts (machine identity client
# secret during bootstrap-cf flow). gitignored because the canonical
# binding target is Cloudflare Workers Builds env vars (set via the
# Builds API), not a repo-local file. The client secret must NEVER
# land in a tracked file.
.infisical/

# Type-check cache
*.tsbuildinfo

# Coverage / test artifacts
coverage/
.vitest-cache/

# Playwright E2E
playwright-report/
test-results/
playwright/.cache/
storybook-static/

# Project-local ephemeral state (project-init policy)
.tmp/
.reference/

# Editor / OS
.DS_Store
.vscode/*
!.vscode/settings.json
.idea/
