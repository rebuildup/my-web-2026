{
	"$schema": "./manifest.schema.json",
	"version": 1,
	"tools": [
		{
			"slug": "prototype",
			"display_name": "ProtoType",
			"description": "ProtoType: a heavy Vite SPA showcase (gsap + three.js + pixi.js + recharts) used as the Tool Registry pilot for Issue #81.",
			"source": {
				"canonical_repo": "https://github.com/rebuildup/ProtoType.git",
				"submodule_path": "external/prototype",
				"pinned_sha": "335e0e861009049336e581dc266dc4e2f019e5c7",
				"branch": "main"
			},
			"build": {
				"command": "pnpm install --frozen-lockfile && pnpm run build",
				"output_dir": "dist",
				"package_manager": "pnpm"
			},
			"delivery": {
				"kind": "same_origin_static",
				"artifact_path": "/tools/prototype/app",
				"entry_html": "/tools/prototype/app/index.html",
				"iframe": {
					"sandbox": "allow-scripts",
					"referrer_policy": "no-referrer"
				},
				"privacy": {
					"third_party_origins": [
						"https://fonts.googleapis.com",
						"https://fonts.gstatic.com",
						"https://script.google.com",
						"https://use.typekit.net"
					],
					"purpose": {
						"ja": "読み込みを開始すると、埋め込み中の ProtoType が Google Fonts / Adobe Typekit から web フォントを取得し、ログイン用 gameset が Google Apps Script のエンドポイントへ通信します（その実装は id / password をクエリ文字列に載せます）。",
						"en": "Once the load starts, the embedded ProtoType document fetches web fonts from Google Fonts and Adobe Typekit, and its login gameset calls a Google Apps Script endpoint (that implementation puts id / password in the query string)."
					},
					"basis": "measured against the pinned ProtoType source at 335e0e8 (index.html, plus src/gamesets/022_Login.ts which src/components/002_Header.tsx reaches); re-measure after a submodule bump (docs/tools/embed-privacy.md section 4)"
				}
			},
			"classification": "same_origin_static",
			"license": "MIT",
			"notes": "Pilot for Issue #81. Heavy Vite SPA — ~1.5MB JS bundle (gsap + three.js + pixi.js). Upstream now carries an operator-owned MIT LICENSE (added by ProtoType#4 / PR rebuildup/ProtoType#5, merge commit 335e0e8), so the previously provisional 'same operator / Berne Convention' framing is now backed by an explicit permissive license. The intermediate `--ignore-scripts` / `build.security.ignore_scripts` workaround was removed at the same time because the obfuscated `preinstall.js` lifecycle script has been deleted upstream."
		},
		{
