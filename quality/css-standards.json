{
	"schema_version": 1,
	"policy": {
		"name": "css-modules-standard",
		"min_declarations": 400,
		"notes": [
			"The vocabulary below is the reviewed baseline: every property, at-rule and value function the shipped CSS may use without an allowlist entry. It is a spec module -> properties table, so a new name arrives by adding it to the module that defines it (reviewable as a one-line diff), never by loosening the gate.",
			"`vendor prefix` and specification-permitted extensions are NOT in this table. They live in `allowlist`, each entry carrying a reason and a basis URL, and each entry must still be in use — an entry that waives nothing fails (`allow_unused`).",
			"min_declarations is a floor, not a target: it exists so a parser regression that stops seeing declarations fails the gate instead of reporting a clean sheet."
		]
	},
	"coverage": {
		"root": "src",
		"extensions": [".css"],
		"notes": "Every stylesheet under `src` must belong to a declared surface; an unowned sheet is never parsed and fails as `surface_uncovered`."
	},
	"surfaces": [
		{
			"id": "panda-generated",
			"kind": "panda-cssgen",
			"role": "the CSS Panda generates from panda.config.ts + src/** — preflight, tokens, recipes and utilities (Issue #413 の対象)",
			"min_declarations": 400
		},
		{
			"id": "src-css",
			"kind": "files",
			"root": "src",
			"extensions": [".css"],
			"role": "hand-written stylesheets shipped by the app (src/styles.css): @font-face descriptors, @layer order, reduced-motion override",
			"min_declarations": 10
		}
	],
