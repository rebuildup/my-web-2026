	"scan": {
		"coverage_root": "src",
		"extensions": [".ts", ".tsx", ".css"],
		"exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.stories.tsx", "**/*.md"],
		"exclude_note": "Test / Storybook / design-doc files never ship to a browser, so they are not adoptions. Generated CSS (`styled-system/**`) is not scanned; both of its inputs are — `panda.config.ts` through the `app-shell` surface, `src/**` through the surfaces above and the coverage root. Files outside `src/` are covered only by explicit surface membership, so a new root-level CSS input has to be declared in a surface to be checked."
	},
	"surfaces": [
		{
			"id": "routes",
			"root": "src/routes",
			"min_files": 1,
			"role": "TanStack Start file routes — every public and admin page entry"
		},
		{
			"id": "editorial",
			"root": "src/editorial",
			"min_files": 1,
			"role": "Shipped editorial visual language: tokens, primitives, nav, analytics"
		},
		{
			"id": "home",
			"root": "src/home",
			"min_files": 1,
			"role": "Home surface (status, reactions, access counter)"
		},
		{
			"id": "portfolio",
			"root": "src/portfolio",
			"min_files": 1,
			"role": "Portfolio surface and media composition"
		},
		{
			"id": "projects",
			"root": "src/projects",
			"min_files": 1,
			"role": "Project introduction surface: the committed snapshot reader, freshness states and the `/projects/dotfiles` page (Issue #621)"
		},
		{
			"id": "admin",
			"root": "src/admin",
			"min_files": 1,
			"role": "Admin surfaces (keys, invitations, images, emoji catalog)"
		},
		{
			"id": "contact",
			"root": "src/contact",
			"min_files": 1,
			"role": "Contact surface"
		},
		{
			"id": "about",
			"root": "src/about",
			"min_files": 1,
			"role": "About surface"
		},
		{
			"id": "tools",
			"root": "src/tools",
			"min_files": 1,
			"role": "Tools registry / detail pages"
		},
		{
			"id": "cloudflare",
			"root": "src/cloudflare",
			"min_files": 1,
			"role": "Cloudflare runtime boundary (auth, health)"
		},
		{
			"id": "http",
			"root": "src/http",
			"min_files": 1,
			"role": "Hono external HTTP boundary"
		},
		{
			"id": "reactions",
			"root": "src/reactions",
			"min_files": 1,
			"role": "DB-backed emoji catalog shared by home/ and admin/"
		},
		{
			"id": "i18n",
			"root": "src/i18n",
			"min_files": 1,
			"role": "Unicode / URL-slug policy leaf obligation (display-text preservation, slug classification, shared decision table)"
		},
		{
			"id": "external-api",
			"root": "src/external-api",
			"min_files": 1,
			"role": "Outbound third-party API reliability contract (snapshot contract, single timeout point, coalescing reader) plus its display primitives"
		},
		{
			"id": "logging",
			"root": "src/logging",
			"min_files": 1,
			"role": "Runtime log-redaction contract: what may appear in a console record, and the only module allowed to reach `console`"
		},
		{
			"id": "legal",
			"root": "src/legal",
			"min_files": 1,
			"role": "Publication-rights review contract for the assets this platform ships and references, plus the surface that shows one asset's rights"
		},
		{
			"id": "privacy",
			"root": "src/privacy",
			"min_files": 1,
			"role": "Published data lifecycle leaf obligation: the registry (stored items, retention, deletion path, external transfer) the public wording renders from"
		},
		{
			"id": "app-shell",
			"files": [
				"src/client.tsx",
				"src/client-zod-config.ts",
				"src/router.tsx",
				"src/server.ts",
				"src/routeTree.gen.ts",
				"src/styles.css",
				"panda.config.ts"
			],
			"min_files": 7,
			"role": "App shell: client entry, its zod non-JIT CSP configuration, router, the generated route tree (the route contract itself), Worker entry, the global Panda layer stylesheet, and `panda.config.ts` — the other input of the generated CSS, whose conditions / globalCss / utilities / theme tokens ship to every browser exactly like `src/**` does"
		}
	],
	"features": [
		{
			"id": "dialog",
			"label": "`<dialog>` element + `showModal()` (Home emoji-reaction picker)",
			"kind": "web-api",
			"detect": ["\\.showModal\\s*\\(", "<dialog\\b"],
			"dataset": {
				"feature_id": "dialog",
				"baseline": "high",
				"baseline_low_date": "2022-03-14",
				"baseline_high_date": "2024-09-14",
				"support": {
					"chrome": "37",
					"edge": "79",
					"firefox": "98",
					"safari": "15.4",
					"safari_ios": "15.4"
				}
			},
			"fallback": null
		},
		{
			"id": "clipboard-write",
			"label": "`navigator.clipboard.writeText()` (Admin copy buttons)",
			"kind": "web-api",
			"detect": ["navigator\\.clipboard\\.writeText\\s*\\("],
			"dataset": {
				"feature_id": "async-clipboard",
				"compat_key": "api.Clipboard.writeText",
				"baseline": "high",
				"baseline_low_date": "2020-03-24",
				"baseline_high_date": "2022-09-24",
				"support": {
					"chrome": "66",
					"edge": "79",
					"firefox": "63",
					"safari": "13.1",
					"safari_ios": "13.4"
				}
			},
			"fallback": null
		},
		{
