{
	"schema_version": 1,
	"policy": {
		"bar": "baseline-widely-available",
		"bar_meaning": "`baseline === \"high\"` in the web-features dataset: the feature reached Baseline \"newly available\" in every core browser and has been available for the 30-month Baseline window. A feature below the bar is only acceptable with an explicit, verified fallback.",
		"target_browsers": [
			{
				"id": "chrome",
				"label": "Chrome",
				"role": "Baseline core (desktop)",
				"floor": "129"
			},
			{
				"id": "edge",
				"label": "Edge",
				"role": "Baseline core (desktop)",
				"floor": "129"
			},
			{
				"id": "firefox",
				"label": "Firefox",
				"role": "Baseline core (desktop)",
				"floor": "131"
			},
			{
				"id": "safari",
				"label": "Safari",
				"role": "Baseline core (desktop)",
				"floor": "18"
			},
			{
				"id": "safari_ios",
				"label": "Safari on iOS",
				"role": "mobile Baseline representative",
				"floor": "18"
			}
		],
		"floor_rule": "A declared floor is verified against the gate: it may never sit below the Baseline Widely available date implied by the adopted feature set (the latest `baseline_high_date` among adopted features, mapped through the vendored release calendar). Raise the floor or drop the feature — never lower the declaration. When no adopted feature is Baseline Widely available the bar implies nothing; the gate cannot compare the floors then and reports `target_floor_unverifiable` as a warning instead of quietly passing."
	},
