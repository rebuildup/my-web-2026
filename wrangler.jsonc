/**
 * Wrangler configuration for my-web-2026.
 *
 * `main` points at the custom Worker entrypoint `src/server.ts`, which
 * dispatches between the Hono external boundary and the TanStack Start
 * default handler. See ADR-0002 for the boundary policy.
 *
 * Bindings:
 *   - ASSETS (Static Assets)        static assets emitted by Vite to ./dist/client
 *   - DB (D1)                        structured content in the provisioned
 *                                    `my-web-2026` database
 *   - MEDIA (R2)                     blobs / media in the provisioned
 *                                    `my-web-2026` bucket
 *
 * `BETTER_AUTH_URL` (Better Auth origin) is intentionally NOT pinned
 * here — production must not silently inherit a localhost default.
 * Provide it per environment:
 *   - local dev:    .dev.vars (loaded by `wrangler dev`)
 *   - remote apply: `wrangler deploy --var BETTER_AUTH_URL=https://...`
 *   - multi-env:    `env.production.vars` / `env.staging.vars` blocks
 * Better Auth 1.5+ infers `baseURL` from the incoming request when
 * unset; the project relies on inference for local development and
 * expects operators to set `BETTER_AUTH_URL` for production to
 * pin the cookie domain + trusted origins. Documented in
 * ADR-0009 §8 and Risks §5.
 *
 * Run `pnpm run cf-typegen` after editing bindings so
 * `worker-configuration.d.ts` stays in sync.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-web-2026",
	"main": "./src/server.ts",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// D1 database created via `wrangler d1 create my-web-2026` on
	// 2026-09-11. Re-run `pnpm run cf-typegen` after any binding
	// change.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-web-2026",
			"database_id": "d761ddb7-8179-48dd-855f-c8b7b2924bad",
			"migrations_dir": "migrations"
		}
	],
	// Production R2 bucket provisioned as `my-web-2026`.
	// The binding name `MEDIA` is stable across releases.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-web-2026"
		}
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/
	 *
	 * "placement": { "mode": "smart" }
	 */
	/**
	 * Additional Cloudflare services (KV, Queues, Durable Objects,
	 * Workflows, Vectorize, Workers AI) are added per release through a
	 * typed binding + `pnpm run cf-typegen` regeneration, gated by ADR-0004.
	 */
	/**
	 * Environment variables / secrets
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 *
	 * Sensitive values are stored as Wrangler secrets, not committed here.
	 */
}
