				],
				"urls": [
					"/projects/dotfiles"
				],
				"reason": "Public project introduction; renders the committed public-README snapshot and states its own freshness. Deliberately not a nav destination, so it is not advertised through the sitemap inventory."
			},
			{
				"id": "/tools/",
				"path": "/tools",
				"classification": "public",
				"sitemap": true,
				"dynamic": null,
				"files": [
					"src/routes/tools.index.tsx"
				],
				"urls": [
					"/tools"
				],
				"reason": "Public tool index. `host_disabled` entries render as \"Coming soon\" and are deliberately not linkable."
			},
			{
				"id": "/tools/$slug",
				"path": null,
				"classification": "public",
				"sitemap": false,
				"dynamic": "integrated-tools",
				"files": [
					"src/routes/tools.$slug.tsx"
				],
				"urls": [
					"/tools/prototype",
					"/tools/readmark"
				],
				"reason": "Per-tool iframe shell. Expands from the tool manifest rows with an embeddable delivery kind, but the shell declares `robots: noindex` in its own head, so it is not a sitemap target."
			}
