/**
 * Production-only overrides for my-web-2026 (Issue #43 / ADR-0014).
 *
 * Mirrors `wrangler.jsonc` (the default / local-dev config) and
 * adds the canonical production wiring:
 *
 *   - `vars.BETTER_AUTH_URL = "https://rebuildup.dev"` — pins the
 *     Better Auth `baseURL` and `trustedOrigins` to the canonical
 *     production origin.
 *   - `routes[].pattern = "rebuildup.dev"` with `custom_domain: true`
 *     and the verified zone id — attaches the Worker to the Cloudflare zone
 *     `rebuildup.dev`. Cloudflare provisions DNS + TLS automatically
 *     when the zone is owned by the operator's account.
 *
 * Canonical production flow:
 *
 *   1. An explicitly approved release PR updates `main`.
 *   2. Cloudflare Workers Builds observes the `main` push.
 *   3. The configured build command produces `dist/`.
 *   4. The configured deploy command applies pending production D1 migrations
 *      and deploys this configuration with Wrangler.
 *
 * GitHub Actions does not deploy production. `pnpm run deploy:production`
 * remains a local recovery/debugging fallback.
 *
 * Why a separate fully-duplicated config (rather than
 * `env.production` inside `wrangler.jsonc`):
 *
 *   1. wrangler 4.131.x does NOT support top-level `extends` in
 *      Wrangler JSON / JSONC files (the message says "current:
 *      4.131.0, latest: 4.135.0 — might support this configuration
 *      option"). Upgrading wrangler is out of scope for this ticket.
 *   2. `env.production` inside `wrangler.jsonc` causes wrangler's
 *      typegen to narrow `__BaseEnv_Env` to env-scoped bindings,
 *      making all top-level bindings optional — which would force
 *      `env.DB!` / `env.MEDIA!` (etc.) non-null assertions on every
 *      binding call site (126 call sites in this codebase).
 *   3. wrangler 4.131.x does not recognize `custom_domains` (added
 *      in 4.135+); `routes` is the supported shape for this version.
 *
 * The duplicated config keeps `wrangler.jsonc` (and its typegen)
 * clean for local dev. Maintenance is acceptable: any change to
 * `wrangler.jsonc` must be mirrored in `wrangler.production.jsonc`
 * (or vice versa). The header comment in `wrangler.jsonc` calls
 * this out.
 *
 * Out of scope (Issue #43 body):
 *   - `www.rebuildup.dev` adoption
 *   - mail / MX / SPF / DKIM
 *   - other subdomain design
 *
 * Required secret names are declared in `secrets.required`. Their values are
 * Worker runtime secrets managed in Cloudflare Settings > Variables & Secrets.
 * Wrangler deploys preserve existing Worker secrets; secret values never live
 * in this file or in the Git repository.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-web-2026",
	// Cloudflare account id (non-secret identifier; obtained via
	// `pnpm exec wrangler whoami` on 2026-09-27, value
	// `c6ab6651a5d4d6d0d07686bbd3c3d56f`). Used by
	// `scripts/infisical-bootstrap-cf.mjs` as the SoT for the
	// Cloudflare Builds API URL. Env var `CLOUDFLARE_ACCOUNT_ID`
	// remains the override path.
	"account_id": "c6ab6651a5d4d6d0d07686bbd3c3d56f",
	"main": "./dist/server/index.js",
	// Vite emits a split ES module graph under `dist/server/assets`. Because this
	// config deploys the prebuilt entrypoint with `no_bundle`, Wrangler needs the
	// same module rule as Vite's generated `dist/server/wrangler.json`.
	"rules": [
		{
			"type": "ESModule",
			"globs": ["**/*.js", "**/*.mjs"]
		}
	],
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-web-2026",
			"database_id": "d761ddb7-8179-48dd-855f-c8b7b2924bad",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-web-2026"
		}
	],
	"vars": {
		"MY_WEB_2026_REACTIONS_TARGET": "home-page",
		"MY_WEB_2026_COUNTER_KEY": "home-page",
		"BETTER_AUTH_URL": "https://rebuildup.dev"
	},
	"secrets": {
		"required": ["BETTER_AUTH_SECRET", "MY_WEB_2026_CONSUMER_API_KEY"]
	},
	"ratelimits": [
		{
			"name": "RATE_LIMIT_WRITE",
			"namespace_id": "00000000000000000000000000000001",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "RATE_LIMIT_READ",
			"namespace_id": "00000000000000000000000000000002",
			"simple": { "limit": 600, "period": 60 }
		}
	],
	// The zone_id below is the verified Cloudflare zone for `rebuildup.dev`.
	// `custom_domain: true` is the hint to Cloudflare to provision
	// DNS + TLS automatically. Pattern is the bare hostname (no
	// `/*`) — Cloudflare routes every path under the hostname to
	// the Worker.
	//
	// 0.3.0 release (PR #48, Issue #43): zone_id verified via the
	// Cloudflare API on 2026-09-20 and committed after operator
	// approval for the production deploy runbook.
	"routes": [
		{
			"pattern": "rebuildup.dev",
			"custom_domain": true,
			"zone_id": "7dde90c8a7be8a304300daa719a7de0a"
		}
	],
	"no_bundle": true
}
