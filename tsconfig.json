{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"types": ["vite/client", "node"],
		"allowJs": true,
		"checkJs": false,
		// Explicit `.ts` import specifiers (Issues #433 and #463). The package
		// is `"type": "module"`, so Node's ESM resolver — and therefore any
		// `.mjs` script that runs a `src/` module directly under Node's type
		// stripping — requires the real extension. Without this flag
		// TypeScript rejects those specifiers, which would force the i18n
		// policy / capture scripts (Issue #433) and the webhook verification
		// report script (Issue #463) to duplicate the shipped adapter instead
		// of executing the same code the contract tests assert on. Every other
		// `src/` import in the repository stays extensionless.
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		// Issue #400: the text-reflow fixtures are read as SOURCE by the
		// reflow gate and the reflow capture (they are the single
		// definition both halves judge), so nothing else compiles them.
		// Without this entry a syntactically broken fixture would pass
		// `pnpm run typecheck` and only fail when somebody runs the
		// capture by hand. The scope is deliberately narrow: the
		// `a11y-image-alt` fixtures under the same directory contain
		// deliberately invalid attributes (`alt={false}`), so they stay
		// out of the type check.
		"scripts/fixtures/a11y-reflow/**/*.tsx",
		"test/integration/**/*.ts",
		// The accessibility suites are type-checked too (Issue #392). The
		// Storybook manifest declares the audited story set and its
		// verdict as a TYPE (`StoryVerdict = 'pass' | 'baseline'`), and a
		// type that is never checked is a comment: `expect: 'fail'` used
		// to compile, because the whole `e2e/` tree was outside this
		// scope and only the runtime guard (`manifest-invalid-verdict`)
		// caught it. The scope is `e2e/a11y/**` because the other suites
		// under `e2e/` predate this decision and carry type errors that
		// are not this ticket's business.
		"e2e/a11y/**/*.ts",
		"worker-configuration.d.ts",
		".cloudflare/types/index.d.ts",
		"styled-system/**/*.ts",
		"vite.config.ts",
		"vitest.config.ts",
		"panda.config.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"dist-cloudflare",
		".output",
		".vinxi",
		".wrangler",
		".tmp",
		".reference"
	]
}
