	"allowlist": {
		"vendor_prefixes": [
			{
				"id": "standard-vendor-prefix",
				"prefixes": ["-webkit-", "-moz-", "-ms-", "-o-"],
				"surfaces": ["panda-generated", "src-css"],
				"require_known_unprefixed": true,
				"reason": "A vendor prefix is accepted only when the unprefixed property is in the vocabulary, so a prefix cannot smuggle a property no specification defines. Removing the prefixed spelling (or registering the unprefixed property first) is always the better fix, which is why this is a rule with a counterparty rather than a free-form waiver.",
				"basis": "https://www.w3.org/TR/css-variables-1/#vendor-prefixes"
			}
		],
		"properties": [
			{
				"id": "panda-preflight-webkit-font-smoothing",
				"name": "-webkit-font-smoothing",
				"kind": "engine-specific",
				"surfaces": ["panda-generated"],
				"reason": "Emitted by Panda's preflight reset to keep CJK and Latin glyph rasterisation as designed on Blink. No specification defines the property and no unprefixed counterpart exists, so it can only be waived by name; dropping it changes rendering on every Chromium visit.",
				"basis": "https://developer.mozilla.org/en-US/docs/Web/CSS/-webkit-font-smoothing"
			},
			{
				"id": "panda-preflight-webkit-tap-highlight-color",
				"name": "-webkit-tap-highlight-color",
				"kind": "engine-specific",
				"surfaces": ["panda-generated"],
				"reason": "Emitted by Panda's preflight reset to suppress the mobile tap highlight on coarse pointers. Engine-specific with no standard counterpart; it is removed by an explicit Panda reset decision, never silently by this gate.",
				"basis": "https://developer.mozilla.org/en-US/docs/Web/CSS/-webkit-tap-highlight-color"
			},
			{
				"id": "panda-preflight-moz-osx-font-smoothing",
				"name": "-moz-osx-font-smoothing",
				"kind": "engine-specific",
				"surfaces": ["panda-generated"],
				"reason": "Emitted by Panda's preflight reset for the Gecko-on-macOS rasterisation path. Engine-specific with no standard counterpart; kept so the reset Panda generates stays byte-stable for the baseline gate (Issue #414).",
				"basis": "https://developer.mozilla.org/en-US/docs/Web/CSS/-moz-osx-font-smoothing"
			}
		],
		"functions": [],
		"at_rules": []
	}
